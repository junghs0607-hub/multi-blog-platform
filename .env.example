# ─────────────────────────────────────────────────────────────
# Mosaic 환경 변수 예시
#   cp .env.example .env.local   (Next.js 와 scripts/* 모두 .env, .env.local 을 읽습니다)
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# docker compose up -d db 로 실행한 PostgreSQL 기본값
DATABASE_URL=postgres://mosaic:mosaic@localhost:5432/mosaic
DB_POOL_MAX=10

# ── App ─────────────────────────────────────────────────────
# 외부에서 접속하는 기본 URL (OG 메타태그, 공유 링크 등에 사용)
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=mosaic_session
SESSION_TTL_DAYS=30
# auto: HTTPS 요청일 때만 Secure 쿠키 / true / false
COOKIE_SECURE=auto
# 이 이메일로 가입하면 자동으로 관리자(admin) 권한이 부여됩니다 (쉼표로 구분)
ADMIN_EMAILS=admin@mosaic.local

# ── Storage ─────────────────────────────────────────────────
# local: 서버 디스크에 저장 / s3: S3 호환 객체 스토리지(AWS S3, MinIO, Cloudflare R2 ...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# STORAGE_DRIVER=s3 일 때 사용
S3_BUCKET=mosaic
S3_REGION=us-east-1
# MinIO/R2 등은 엔드포인트 지정 (AWS S3 는 비워두면 됩니다)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# 버킷이 공개(CDN)라면 공개 URL 지정 → 이미지가 CDN 에서 직접 서빙됩니다.
# 비워두면 /api/files/* 프록시를 통해 서빙됩니다.
S3_PUBLIC_URL=

# ── Upload 검증 ──────────────────────────────────────────────
UPLOAD_MAX_MB=10
UPLOAD_MIN_DIMENSION=64
UPLOAD_MAX_DIMENSION=12000
UPLOAD_MAX_PIXELS=80000000
# 지각 해시(dHash, 64bit) 해밍 거리 임계값: 이 값 이하이면 '유사 이미지'로 경고 (0~11, 권장 5~7)
#  측정값(리사이즈/재압축 사본의 감지율): ≤3 약 80%, ≤6 약 93~98%  /  무관한 이미지 오탐 ≤6 약 0.2%
DUPLICATE_PHASH_THRESHOLD=6

# ── 보안 ────────────────────────────────────────────────────
# 로그인/가입/업로드/댓글/신고 레이트 리밋 (부하·E2E 테스트 시에만 false)
RATE_LIMIT_ENABLED=true

# ── Background jobs / AI ────────────────────────────────────
# inline: 업로드 응답 직후 같은 프로세스에서 분석 작업 실행
# worker: 별도 워커 프로세스(npm run worker)가 jobs 테이블을 폴링하여 처리
JOB_MODE=inline
# 활성화할 이미지 분석기 목록 (쉼표 구분). 기본 제공: basic (색상 팔레트/색상 태그)
AI_ANALYZERS=basic
# 분석 결과 라벨을 핀의 자동 태그(source=ai)로 추가할지 여부
AUTO_TAG_ENABLED=true
AUTO_TAG_MIN_CONFIDENCE=0.2

# ── 개발 서버 ────────────────────────────────────────────────
# 터널/원격 개발 환경에서 dev 서버 접근 허용 호스트 (예: *.ngrok.app)
ALLOWED_DEV_ORIGINS=
